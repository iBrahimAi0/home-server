# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Home Server Dashboard Frontend Configuration
# URL pointing to the Express Backend API (:3001)
# Replace SERVER-IP with your actual Ubuntu Server IP (e.g. found via `hostname -I`)
NEXT_PUBLIC_API_URL=http://SERVER-IP:3001
NEXT_PUBLIC_SOCKET_URL=http://SERVER-IP:3001
